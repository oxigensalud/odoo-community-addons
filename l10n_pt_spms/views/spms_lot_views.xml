<odoo>
    <record id="spms_lot_form_view" model="ir.ui.view">
        <field name="model">spms.lot</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spms_lot_tree_view" model="ir.ui.view">
        <field name="model">spms.lot</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="spms_lot_search_view" model="ir.ui.view">
        <field name="model">spms.lot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="spms_lot_act_window" model="ir.actions.act_window">
        <field name="name">SPMS Lot</field>
        <field name="res_model">spms.lot</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="spms_lot_menu" model="ir.ui.menu">
        <field name="name">Lot</field>
        <field name="parent_id" ref="spms_root_menu" />
        <field name="action" ref="spms_lot_act_window" />
        <field name="sequence" eval="10" />
    </record>
</odoo>
