<odoo>
    <record id="spms_error_type_form_view" model="ir.ui.view">
        <field name="model">spms.error.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="description" />
                        <field name="note" />
                        <field name="usual_level" />
                        <field name="is_noise" />
                        <field name="to_classify" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spms_error_type_tree_view" model="ir.ui.view">
        <field name="model">spms.error.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="note" />
                <field name="description" optional="hide" />
                <field name="usual_level" />
                <field name="is_noise" />
                <field name="to_classify" />
            </tree>
        </field>
    </record>

    <record id="spms_error_type_search_view" model="ir.ui.view">
        <field name="model">spms.error.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="description" />
                <field name="note" />
                <filter
                    string="To Classify"
                    name="to_classify"
                    domain="[('to_classify', '=', True)]"
                />
                <filter
                    string="Noise"
                    name="is_noise"
                    domain="[('is_noise', '=', True)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Usual Level"
                        name="group_by_usual_level"
                        context="{'group_by': 'usual_level'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="spms_error_type_act_window" model="ir.actions.act_window">
        <field name="name">SPMS Error Type</field>
        <field name="res_model">spms.error.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="spms_error_type_menu" model="ir.ui.menu">
        <field name="name">Error Type</field>
        <field name="parent_id" ref="spms_root_menu" />
        <field name="action" ref="spms_error_type_act_window" />
        <field name="sequence" eval="60" />
    </record>
</odoo>
