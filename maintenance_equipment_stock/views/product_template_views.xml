<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field
            name="name"
        >product.template.form (in maintenance_equipment_stock)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tracking']/.." position="after">
                <field name="maintenance_lot" invisible="tracking != 'serial'" />
            </xpath>
            <notebook position="inside">
                <page
                    name="maintenance"
                    string="Maintenance"
                    invisible="maintenance_lot == False or not is_storable or tracking != 'serial'"
                >
                    <group>
                        <group>
                            <field name="maintenance_category_id" />
                            <field name="maintenance_team_id" />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
